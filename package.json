{
  "name": "@kokoa/clotho-editor",
  "version": "0.1.2",
  "description": "Visual editor for clotho animation documents",
  "license": "MIT",
  "author": "kokoa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinkeonkim/clotho-editor.git"
  },
  "homepage": "https://github.com/shinkeonkim/clotho-editor#readme",
  "bugs": {
    "url": "https://github.com/shinkeonkim/clotho-editor/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/clotho-editor.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "visual-check": "bun examples/visual-check.html",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "app:dev": "bun app/index.html",
    "app:build": "bun build ./app/index.html --outdir ./worker-dist --target browser --minify",
    "worker:dev": "bun run app:build && wrangler dev",
    "worker:deploy": "bun run app:build && wrangler deploy",
    "release:check": "bun scripts/release-check.ts"
  },
  "peerDependencies": {
    "@kokoa/clotho": "^0.1.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kokoa/clotho": "^0.1.2",
    "@types/bun": "^1.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.1"
  },
  "keywords": [
    "clotho",
    "animation",
    "editor",
    "svg"
  ]
}
